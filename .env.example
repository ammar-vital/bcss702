# Public origin used for canonicals, Open Graph URLs, robots.txt and the sitemap.
NEXT_PUBLIC_SITE_URL=https://bcss702.com

# Where contact-form submissions are delivered (comma separated).
CONTACT_RECIPIENTS=info@bcss702.com

# SMTP transport for the contact form. Without SMTP_HOST the form returns an
# error and the submission is written to the server log instead of being mailed.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@bcss702.com
